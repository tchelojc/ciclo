class SolarSystemView(QWidget):
    """Visualização simplificada do sistema solar"""
    def __init__(self, connector):
        super().__init__()
        self.connector = connector
        self.setup_ui()
        
    def setup_ui(self):
        self.layout = QVBoxLayout(self)
        self.canvas = QLabel()
        self.canvas.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addWidget(self.canvas)
        
    def update_positions(self, date):
        """Atualiza as posições planetárias"""
        # Implementação simplificada - pode ser substituída por OpenGL
        try:
            from PIL import Image, ImageDraw
            width, height = 600, 400
            img = Image.new('RGB', (width, height), (10, 10, 30))
            draw = ImageDraw.Draw(img)
            
            # Desenha o sol no centro
            draw.ellipse((290, 190, 310, 210), fill=(255, 215, 0))
            
            # Obter posições planetárias
            if hasattr(self.connector, 'astronomy'):
                positions = self.connector.astronomy.get_planetary_positions(date.toPyDate())
                
                # Desenha planetas (simplificado)
                for planet, data in positions.items():
                    angle = math.radians(data.get('position', 0))
                    distance = 50 + 20 * data.get('phase', 0) * 5
                    x = width/2 + distance * math.cos(angle)
                    y = height/2 + distance * math.sin(angle)
                    
                    color = {
                        'venus': (255, 160, 122),
                        'earth': (100, 149, 237),
                        'mars': (255, 69, 0)
                    }.get(planet, (200, 200, 200))
                    
                    size = 8 if planet != 'sun' else 12
                    draw.ellipse((x-size/2, y-size/2, x+size/2, y+size/2), fill=color)
            
            # Converte para QPixmap e exibe
            from PIL.ImageQt import ImageQt
            from PyQt6.QtGui import QPixmap
            qim = ImageQt(img)
            self.canvas.setPixmap(QPixmap.fromImage(qim))
            
        except ImportError:
            self.canvas.setText("Instale Pillow para visualização do sistema solar")
        except Exception as e:
            print(f"Erro ao renderizar sistema solar: {str(e)}")
            self.canvas.setText("Erro ao renderizar visualização")